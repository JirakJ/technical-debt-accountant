<idea-plugin>
    <id>com.jakubjirak.debtaccountant</id>
    <name>Technical Debt Accountant</name>
    <vendor email="jakub@jirak.dev" url="https://github.com/jakubjirak">Jakub Jirák</vendor>

    <description><![CDATA[
    <h2>Technical Debt Accountant</h2>
    <p>Quantify technical debt in dollars. Track workaround costs, calculate ROI of refactoring,
    and generate management-ready reports in business language.</p>

    <h3>Free Features</h3>
    <ul>
        <li><b>Debt Inventory</b> — catalog tech debt items with categories and priority (up to 50)</li>
        <li><b>Time Tracker</b> — log workaround time spent on each item</li>
        <li><b>Hotspot Detection</b> — find files with the most accumulated debt</li>
        <li><b>Git Integration</b> — link debt to commits, track age via blame</li>
    </ul>

    <h3>Pro Features ($8/month)</h3>
    <ul>
        <li><b>Dollar Valuation</b> — set hourly rate, see debt in currency</li>
        <li><b>Interest Rate</b> — track how debt cost grows monthly</li>
        <li><b>ROI Calculator</b> — prioritize refactoring by payback period</li>
        <li><b>Burndown Chart</b> — visualize debt resolution over time</li>
        <li><b>Management Reports</b> — export Markdown reports for stakeholders</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="git-features.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Tech Debt"
                anchor="bottom"
                secondary="true"
                icon="AllIcons.Nodes.Aspect"
                factoryClass="com.jakubjirak.debtaccountant.ui.DebtToolWindowFactory"/>

        <applicationConfigurable
                id="com.jakubjirak.debtaccountant.settings"
                parentId="tools"
                displayName="Technical Debt Accountant"
                instance="com.jakubjirak.debtaccountant.settings.DebtAccountantConfigurable"/>

        <applicationService
                serviceImplementation="com.jakubjirak.debtaccountant.settings.DebtAccountantSettings"/>

        <applicationService
                serviceImplementation="com.jakubjirak.debtaccountant.licensing.FreemiumGate"/>

        <projectService
                serviceImplementation="com.jakubjirak.debtaccountant.store.DebtInventoryStore"/>

        <projectService
                serviceImplementation="com.jakubjirak.debtaccountant.tracker.WorkaroundTracker"/>

        <projectActivity
                implementation="com.jakubjirak.debtaccountant.DebtAccountantStartupActivity"/>

        <notificationGroup
                id="Tech Debt Accountant"
                displayType="BALLOON"
                toolWindowId="Tech Debt"/>
    </extensions>

    <actions>
        <action id="com.jakubjirak.debtaccountant.AddDebtAction"
                class="com.jakubjirak.debtaccountant.ui.AddDebtAction"
                text="Add Debt Item"
                description="Add a technical debt item at the current cursor position"
                icon="AllIcons.General.Add">
            <keyboard-shortcut first-keystroke="alt D" keymap="$default"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="com.jakubjirak.debtaccountant.LogWorkaroundAction"
                class="com.jakubjirak.debtaccountant.ui.LogWorkaroundAction"
                text="Log Workaround Time"
                description="Log time spent on a workaround for a debt item"
                icon="AllIcons.Actions.Profile">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.jakubjirak.debtaccountant.GenerateReportAction"
                class="com.jakubjirak.debtaccountant.ui.GenerateReportAction"
                text="Generate Debt Report"
                description="Generate a management-ready technical debt report"
                icon="AllIcons.Actions.Preview">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
